[Unit]
Description=BetBoy failure alert for %i

[Service]
Type=oneshot
User=betboy
Group=betboy
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/betboy/app
EnvironmentFile=-/etc/betboy/betboy.env
Environment=PYTHONUTF8=1
ExecStart=/usr/bin/python3 -I /usr/local/libexec/betboy-alert.py %i
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
