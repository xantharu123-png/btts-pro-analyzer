[Unit]
Description=Create consistent BetBoy SQLite backups

[Service]
Type=oneshot
User=betboy
Group=betboy
WorkingDirectory=/opt/betboy/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
ExecStart=/opt/betboy/venv/bin/python scripts/backup_runtime_databases.py --output-dir /var/backups/betboy --retention-days 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
TimeoutStartSec=30min
