[Unit]
Description=Settle open BetBoy red-card Shadow signals
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=betboy
Group=betboy
WorkingDirectory=/opt/betboy/app
EnvironmentFile=-/etc/betboy/betboy.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
ExecCondition=/usr/bin/python3 -I /usr/local/libexec/betboy-challenge-migration-marker.py --marker /etc/betboy/challenge-ledger-v2-migrated.json --application-root /opt/betboy/app require-complete
ExecStart=/opt/betboy/venv/bin/python redcard_signal_log.py --settle --stats --max 25
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
TimeoutStartSec=15min
