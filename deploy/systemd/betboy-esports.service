[Unit]
Description=BetBoy E-Sport Shadow scan and settlement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=betboy
Group=betboy
WorkingDirectory=/opt/betboy/app
EnvironmentFile=-/etc/betboy/betboy.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
ExecStart=/opt/betboy/venv/bin/python esports_shadow_automation.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
TimeoutStartSec=15min
