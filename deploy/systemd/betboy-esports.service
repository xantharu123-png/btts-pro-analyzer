[Unit]
Description=BetBoy E-Sport Shadow scan and settlement
After=network-online.target betboy-wettfinder.service betboy-tennis.service
Wants=network-online.target
OnFailure=betboy-alert@%n.service

[Service]
Type=oneshot
User=betboy
Group=betboy
WorkingDirectory=/opt/betboy/app
EnvironmentFile=-/etc/betboy/betboy.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
ExecCondition=/usr/bin/python3 -I /usr/local/libexec/betboy-challenge-migration-marker.py --marker /etc/betboy/challenge-ledger-v2-migrated.json --application-root /opt/betboy/app require-complete
ExecStart=/opt/betboy/venv/bin/python esports_shadow_automation.py
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
TimeoutStartSec=15min
