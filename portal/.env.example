BETBOY_MAIL_USER=
BETBOY_MAIL_PASSWORD=
BETBOY_MAIL_FROM=
BETBOY_STRIPE_SECRET_KEY=
BETBOY_STRIPE_WEBHOOK_SECRET=
BETBOY_STRIPE_PRICE_STARTER=
BETBOY_STRIPE_PRICE_PLUS=
