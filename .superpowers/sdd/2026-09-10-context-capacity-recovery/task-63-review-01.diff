+def test_native_bindings_and_error_unwind_with_modeled_limit_provider(tmp_path,monkeypatch,fault):
+    """Real Linux descriptors/epochs; the limit provider here is explicitly modeled."""
+    c=catalogue()
+    directory=tmp_path/'inputs'
