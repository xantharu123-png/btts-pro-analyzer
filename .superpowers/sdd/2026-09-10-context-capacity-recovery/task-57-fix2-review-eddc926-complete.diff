++    if selected is None:
++        visit(root, 0)
++    else:
++        before = identity(root.lstat())
++        for name in selected:
++            path = root / name
++            if stat.S_ISDIR(path.lstat().st_mode):
++                visit(path, 0)
++            else:
++                entries.append({"path": name, **file_record(path)})
